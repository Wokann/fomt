FARM_STATUS_PACKED_BIN := $(FARM_STATUS_TILES_BIN).lz
FARM_STATUS_CODEC := tools/marvelous_codec.py
FARM_STATUS_PREVIEW_TOOL := tools/farm_status_previews.py
