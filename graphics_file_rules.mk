.SECONDARY: $(MAP_DATA_TILE_OUTPUTS) $(MAP_DATA_PALETTE_OUTPUTS)
$(BUILD_DIR)/asm/data/data_0813B288.o: $(MAP_DATA_INC) $(MAP_DATA_PACKED)

