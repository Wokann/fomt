	@$(PYTHON) $(OAM_PACK_AUDIT) $(OAM_PACK) baserom_jp.gba \
	  --archive-offset $(PORTRAIT_ARCHIVE_OFFSET_JP) \
	  --source $(PORTRAIT_SOURCE_DIR)/full --output $(BUILD_DIR)/graphics/oam_pack/audit
