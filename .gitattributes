# A raw trailing space is the byte mapping for U+0020 in this table.
charmap_jp.txt whitespace=-trailing-space

# Native GBA tile payloads are opaque binary source resources.
*.4bpp binary
*.tilemap binary
*.bin binary
*.pal text eol=crlf

# Compiler patches retain verbatim upstream whitespace and LF context lines.
*.patch text eol=lf -whitespace
tools/install_agbcp.sh text eol=lf
