new file mode 100644
--- /dev/null
+++ b/tests/long-call-start.s
@@ -0,0 +1,82 @@
+.syntax unified
+.arm
+.section .text.start
+.global _start
+_start:
+    ldr r3, =main
+    mov lr, pc
+    bx r3
+    mov r7, #1
+    svc #0
+
+.thumb
+.section .text.near
+.thumb_func
+.global near_value
+near_value:
+    movs r1, #3
+    muls r0, r1
+    bx lr
+.thumb_func
+.global near_sink
+near_sink:
+    ldr r1, =near_seen
+    str r0, [r1]
+    bx lr
+.thumb_func
+.global _call_via_r1
+_call_via_r1:
+    bx r1
+.thumb_func
+.global _call_via_r2
+_call_via_r2:
+    bx r2
+.thumb_func
+.global _call_via_r3
+_call_via_r3:
+    bx r3
+.thumb_func
+.global memcpy
+memcpy:
+    push {r4, lr}
+    movs r3, r0
+    cmp r2, #0
+    beq .Lcopy_done
+.Lcopy:
+    ldrb r4, [r1]
+    strb r4, [r3]
+    adds r1, #1
+    adds r3, #1
+    subs r2, #1
+    bne .Lcopy
+.Lcopy_done:
+    pop {r4}
+    pop {r1}
+    bx r1
+
+.arm
+.section .text.far
+.global far_value
+.type far_value, %function
+far_value:
+    add r0, r0, #7
+    bx lr
+.global far_sink
+.type far_sink, %function
+far_sink:
+    ldr r1, =far_seen
+    str r0, [r1]
+    bx lr
+.global far_pair
+.type far_pair, %function
+far_pair:
+    str r1, [r0]
+    add r1, r1, #3
+    str r1, [r0, #4]
+    bx lr
+
+.data
+.global far_seen
+far_seen: .word 0
+.global near_seen
+near_seen: .word 0
