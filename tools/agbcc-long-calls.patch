diff --git a/tests/long-call.c b/tests/long-call.c
new file mode 100644
--- /dev/null
+++ b/tests/long-call.c
@@ -0,0 +1,50 @@
+/* Run as either ordinary C or C++, with no file-wide long-call option. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct Pair { int first; int second; };
+extern int far_value(int);
+extern int far_value(int) __attribute__((long_call));
+extern int far_value(int);
+extern void far_sink(int) __attribute__((long_call));
+extern struct Pair far_pair(int) __attribute__((long_call));
+extern int near_value(int);
+extern void near_sink(int);
+extern volatile int far_seen;
+extern volatile int near_seen;
+
+int mixed_value(int input)
+{
+    return near_value(far_value(input)) + 1;
+}
+
+void mixed_sink(int input)
+{
+    far_sink(input);
+    near_sink(input + 1);
+}
+
+int pair_value(int input)
+{
+    struct Pair value = far_pair(input);
+    return value.first + value.second;
+}
+
+void __gccmain(void) {}
+
+int main(void)
+{
+    if (mixed_value(5) != 37)
+        return 1;
+    mixed_sink(9);
+    if (far_seen != 9 || near_seen != 10)
+        return 2;
+    if (pair_value(4) != 11)
+        return 3;
+    return 0;
+}
+
+#ifdef __cplusplus
+}
+#endif
