diff --git a/tests/asm-destructor.cc b/tests/asm-destructor.cc
new file mode 100644
--- /dev/null
+++ b/tests/asm-destructor.cc
@@ -0,0 +1,53 @@
+// Execution regression for GNU C++'s asm-labelled destructor declarations.
+// The asm labels identify implementations, not the source-level method kind.
+static int order;
+static int deletions;
+static union { unsigned long align; char bytes[64]; } allocation;
+
+void * operator new(unsigned long) { return allocation.bytes; }
+void operator delete(void *) { ++deletions; }
+extern "C" void __gccmain(void) {}
+
+struct Leaf {
+    int value;
+    Leaf(int v = 3) : value(v) {}
+    ~Leaf() asm("leaf_cleanup");
+};
+Leaf::~Leaf() { order = order * 10 + value; }
+
+struct Base {
+    virtual int Value() { return 9; }
+    virtual ~Base() asm("base_cleanup");
+};
+Base::~Base() { order = order * 10 + 9; }
+
+struct Derived : Base {
+    int Value() { return 4; }
+    ~Derived() asm("derived_cleanup");
+};
+Derived::~Derived() { order = order * 10 + 4; }
+
+template<class T> struct Holder {
+    T value;
+    Holder(int v) : value(v) {}
+    ~Holder();
+};
+template<class T> Holder<T>::~Holder() { order = order * 10 + 7; }
+
+int main()
+{
+    { Leaf first(1); Leaf second(2); }
+    if (order != 21) return 1;
+    order = 0;
+    { Leaf array[2]; }
+    if (order != 33) return 2;
+    order = 0;
+    Base * base = new Derived;
+    if (base->Value() != 4) return 3;
+    delete base;
+    if (order != 49 || deletions != 1) return 4;
+    order = 0;
+    { Holder<Leaf> holder(5); }
+    if (order != 75) return 5;
+    return 0;
+}
